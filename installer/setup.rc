#include <winver.h>
#include <winuser.h>
#include "../fix/version.h"

101 RCDATA "../build/CrashRpt.dll"
102 RCDATA "../config/m4fix.ini"
1 RT_MANIFEST "setup.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     M4FIX_VERSION_MAJOR, M4FIX_VERSION_MINOR, M4FIX_VERSION_PATCH, 0
PRODUCTVERSION  M4FIX_VERSION_MAJOR, M4FIX_VERSION_MINOR, M4FIX_VERSION_PATCH, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "m4fix (unofficial community fix)"
            VALUE "FileDescription",  "m4fix setup - Myst IV: Revelation navigation performance fix"
            VALUE "FileVersion",      M4FIX_VERSION_STR
            VALUE "OriginalFilename", "m4fix-setup.exe"
            VALUE "ProductName",      "m4fix"
            VALUE "ProductVersion",   M4FIX_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
