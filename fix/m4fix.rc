#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     M4FIX_VERSION_MAJOR, M4FIX_VERSION_MINOR, M4FIX_VERSION_PATCH, 0
PRODUCTVERSION  M4FIX_VERSION_MAJOR, M4FIX_VERSION_MINOR, M4FIX_VERSION_PATCH, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "m4fix (unofficial community fix)"
            VALUE "FileDescription",  "m4fix - Myst IV: Revelation navigation performance fix (CrashRpt proxy)"
            VALUE "FileVersion",      M4FIX_VERSION_STR
            VALUE "InternalName",     "m4fix"
            VALUE "OriginalFilename", "CrashRpt.dll"
            VALUE "ProductName",      "m4fix"
            VALUE "ProductVersion",   M4FIX_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
